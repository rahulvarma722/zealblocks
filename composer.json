{
	"name": "amandubey/zealblocks",
	"description": "A Gutenberg block collection built on the WordPress 7.1 block API.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Aman Dubey",
			"homepage": "https://amandubey.com/"
		}
	],
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.10",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpunit/phpunit": "^10.5"
	},
	"scripts": {
		"lint": "phpcs",
		"lint:summary": "phpcs --report=summary",
		"format": "phpcbf",
		"test": "phpunit",
		"test:integration": "./bin/test-integration.sh"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
