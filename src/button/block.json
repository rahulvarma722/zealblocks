{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "zealblocks/button",
	"version": "0.0.3-beta",
	"title": "Button",
	"category": "zealblocks",
	"icon": "button",
	"description": "Prompt visitors to take action with a button-style link.",
	"keywords": [
		"link"
	],
	"textdomain": "zealblocks",
	"parent": [
		"zealblocks/buttons"
	],
	"attributes": {
		"text": {
			"type": "string",
			"default": ""
		},
		"url": {
			"type": "string",
			"default": ""
		},
		"linkTarget": {
			"type": "string",
			"default": ""
		},
		"rel": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"tagName": {
			"type": "string",
			"enum": [
				"a",
				"button"
			],
			"default": "a"
		},
		"icon": {
			"type": "string",
			"default": ""
		},
		"iconPosition": {
			"type": "string",
			"enum": [
				"left",
				"right"
			],
			"default": "right"
		},
		"flipForRTL": {
			"type": "boolean",
			"default": false
		},
		"iconRotation": {
			"type": "number",
			"default": 0
		},
		"showText": {
			"type": "boolean",
			"default": true
		},
		"showIconOnHover": {
			"type": "boolean",
			"default": false
		},
		"hoverIcon": {
			"type": "string",
			"default": ""
		},
		"hoverIconPosition": {
			"type": "string",
			"enum": [
				"left",
				"right"
			],
			"default": "right"
		},
		"hoverIconRotation": {
			"type": "number",
			"default": 0
		},
		"hoverIconFlipForRTL": {
			"type": "boolean",
			"default": false
		},
		"hoverIconAriaLabel": {
			"type": "string",
			"default": ""
		},
		"animationType": {
			"type": "string",
			"default": ""
		},
		"animationDuration": {
			"type": "number",
			"default": 400
		},
		"animationDelay": {
			"type": "number",
			"default": 0
		},
		"animationEasing": {
			"type": "string",
			"enum": [
				"ease",
				"ease-in",
				"ease-out",
				"ease-in-out",
				"linear"
			],
			"default": "ease"
		},
		"animationRepeat": {
			"type": "boolean",
			"default": false
		},
		"displayConditions": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": false,
		"alignWide": false,
		"reusable": false,
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"textAlign": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalLetterSpacing": true,
			"__experimentalWritingMode": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"__experimentalDefaultControls": {
				"padding": true
			}
		},
		"color": {
			"gradients": true,
			"text": true,
			"background": true,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true
			}
		},
		"shadow": true,
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"__experimentalDefaultControls": {
				"color": true,
				"radius": true,
				"style": true,
				"width": true
			}
		}
	},
	"styles": [
		{
			"name": "fill",
			"label": "Fill",
			"isDefault": true
		},
		{
			"name": "outline",
			"label": "Outline"
		}
	],
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css",
	"render": "file:./render.php"
}
