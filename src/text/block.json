{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "zealblocks/text",
	"version": "0.0.1",
	"title": "Text",
	"category": "zealblocks",
	"icon": "editor-textcolor",
	"description": "Text with a visual style chosen independently of the theme\u2019s default sizing.",
	"keywords": [
		"text",
		"paragraph",
		"typography",
		"style"
	],
	"textdomain": "zealblocks",
	"attributes": {
		"content": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"styleAs": {
			"type": "string",
			"default": ""
		},
		"placeholder": {
			"type": "string"
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"splitting": true,
		"align": [
			"wide",
			"full"
		],
		"shadow": true,
		"__experimentalSlashInserter": true,
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"textAlign": true,
			"textColumns": true,
			"textIndent": true,
			"__experimentalFontFamily": true,
			"__experimentalFontStyle": true,
			"__experimentalFontWeight": true,
			"__experimentalLetterSpacing": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalWritingMode": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"color": {
			"gradients": true,
			"link": true,
			"text": true,
			"background": true,
			"__experimentalDefaultControls": {
				"text": true,
				"background": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"__experimentalDefaultControls": {
				"padding": true
			}
		},
		"dimensions": {
			"minHeight": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"__experimentalDefaultControls": {
				"color": true,
				"radius": true,
				"style": true,
				"width": true
			}
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css",
	"render": "file:./render.php"
}
