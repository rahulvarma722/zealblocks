{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "zealblocks/text",
	"version": "0.0.2-beta",
	"title": "Text",
	"category": "zealblocks",
	"icon": "editor-textcolor",
	"description": "Text with a visual style chosen independently of the theme\u2019s default sizing.",
	"keywords": [
		"text",
		"paragraph",
		"typography",
		"style"
	],
	"textdomain": "zealblocks",
	"attributes": {
		"content": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"tagName": {
			"type": "string",
			"enum": [
				"p",
				"h1",
				"h2",
				"h3",
				"h4",
				"h5",
				"h6",
				"div",
				"span",
				"blockquote",
				"address",
				"cite",
				"time",
				"label",
				"figcaption",
				"caption",
				"legend",
				"dt",
				"dd",
				"li",
				"summary",
				"pre",
				"strong",
				"em",
				"small",
				"mark",
				"del",
				"ins",
				"sub",
				"sup",
				"abbr",
				"code",
				"kbd",
				"samp",
				"var",
				"output",
				"q",
				"s",
				"dfn",
				"bdi",
				"bdo"
			],
			"default": "p"
		},
		"styleAs": {
			"type": "string",
			"default": ""
		},
		"dropCap": {
			"type": "boolean",
			"default": false
		},
		"animationType": {
			"type": "string",
			"default": ""
		},
		"animationDuration": {
			"type": "number",
			"default": 400
		},
		"animationDelay": {
			"type": "number",
			"default": 0
		},
		"animationEasing": {
			"type": "string",
			"enum": [
				"ease",
				"ease-in",
				"ease-out",
				"ease-in-out",
				"linear"
			],
			"default": "ease"
		},
		"animationRepeat": {
			"type": "boolean",
			"default": false
		},
		"displayConditions": {
			"type": "object",
			"default": {}
		},
		"positionPreview": {
			"type": "boolean",
			"default": true
		},
		"placeholder": {
			"type": "string"
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"splitting": true,
		"align": [
			"wide",
			"full"
		],
		"shadow": true,
		"__experimentalSlashInserter": true,
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"textAlign": true,
			"textColumns": true,
			"textIndent": true,
			"__experimentalFontFamily": true,
			"__experimentalFontStyle": true,
			"__experimentalFontWeight": true,
			"__experimentalLetterSpacing": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalWritingMode": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"color": {
			"gradients": true,
			"link": true,
			"text": true,
			"background": true,
			"__experimentalDefaultControls": {
				"text": true,
				"background": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"__experimentalDefaultControls": {
				"padding": true
			}
		},
		"dimensions": {
			"minHeight": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"__experimentalDefaultControls": {
				"color": true,
				"radius": true,
				"style": true,
				"width": true
			}
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css",
	"render": "file:./render.php"
}
