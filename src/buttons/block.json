{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "zealblocks/buttons",
	"version": "0.0.2-beta",
	"title": "Buttons",
	"category": "zealblocks",
	"icon": "button",
	"description": "Prompt visitors to take action with a group of button-style links.",
	"keywords": [ "link", "button" ],
	"textdomain": "zealblocks",

	"allowedBlocks": [ "zealblocks/button" ],

	"attributes": {
		"animationType": {
			"type": "string",
			"default": ""
		},
		"animationDuration": {
			"type": "number",
			"default": 400
		},
		"animationDelay": {
			"type": "number",
			"default": 0
		},
		"animationEasing": {
			"type": "string",
			"enum": [
				"ease",
				"ease-in",
				"ease-out",
				"ease-in-out",
				"linear"
			],
			"default": "ease"
		},
		"animationRepeat": {
			"type": "boolean",
			"default": false
		}
	},

	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"spacing": {
			"blockGap": [ "horizontal", "vertical" ],
			"padding": true,
			"margin": true,
			"__experimentalDefaultControls": {
				"blockGap": true
			}
		},
		"color": {
			"gradients": true,
			"text": false,
			"background": true,
			"__experimentalDefaultControls": {
				"background": true
			}
		},
		"shadow": true,
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"__experimentalDefaultControls": {
				"color": true,
				"radius": true,
				"style": true,
				"width": true
			}
		},
		"layout": {
			"allowSwitching": false,
			"allowInheriting": false,
			"default": {
				"type": "flex"
			}
		},
		"listView": true
	},

	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css",
	"render": "file:./render.php"
}
