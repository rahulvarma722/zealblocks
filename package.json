{
	"name": "zealblocks",
	"version": "0.0.1",
	"description": "A Gutenberg block collection built on the WordPress 7.1 block API.",
	"private": true,
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"lint:js": "wp-scripts lint-js",
		"lint:css": "wp-scripts lint-style",
		"format": "wp-scripts format",
		"build:zip": "npm run build && ./bin/build-zip.sh",
		"lint:php": "vendor/bin/phpcs",
		"format:php": "vendor/bin/phpcbf",
		"test:js": "wp-scripts test-unit-js",
		"test:php": "vendor/bin/phpunit",
		"test:integration": "./bin/test-integration.sh",
		"test": "npm run test:php && npm run test:js",
		"update-icons": "node bin/generate-icons-json.js --version=7.3.1"
	},
	"devDependencies": {
		"@wordpress/scripts": "^30.0.0",
		"autoprefixer": "^10.6.1",
		"js-yaml": "^4.1.0",
		"postcss": "^8.5.28",
		"tailwindcss": "^3.4.19",
		"tailwindcss-animate": "^1.0.7"
	},
	"overrides": {
		"typescript": "~5.9.0"
	},
	"author": {
		"name": "Aman Dubey",
		"url": "https://amandubey.com/"
	},
	"dependencies": {
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-slot": "^1.3.3",
		"@tanstack/react-virtual": "^3.14.13",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.48.0",
		"tailwind-merge": "^3.7.0"
	}
}
